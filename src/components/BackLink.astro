---
interface Props {
  href?: string;
  label?: string;
}

const { href = "/", label = "back" } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 text-muted-foreground no-underline transition-colors hover:text-foreground"
>
  <span aria-hidden="true">←</span>
  <span>{label}</span>
</a>
