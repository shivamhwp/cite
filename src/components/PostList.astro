---
import { formatDate, postHref, sortDate, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="flex flex-col">
  {
    posts.map((post) => (
      <li>
        <a
          href={postHref(post)}
          class="flex flex-col gap-0.5 py-1.5 text-muted-foreground no-underline transition-colors hover:text-foreground sm:flex-row sm:items-baseline sm:justify-between sm:gap-4 sm:py-1"
        >
          <span>{post.data.title}</span>
          <time
            class="shrink-0 whitespace-nowrap text-foreground/35 tabular-nums"
            datetime={sortDate(post).toISOString()}
          >
            {formatDate(sortDate(post))}
          </time>
        </a>
      </li>
    ))
  }
</ul>
