---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { CommandPalette } from "@/components/CommandPalette";
import { collectUrls } from "@/lib/urls";
import { SITE } from "@/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  type = "website",
  published,
  updated,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
const urls = await collectUrls();

const jsonLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        url: canonical,
        image: imageUrl,
        datePublished: published?.toISOString(),
        dateModified: (updated ?? published)?.toISOString(),
        author: { "@type": "Person", name: SITE.name, url: SITE.url },
      }
    : {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: SITE.domain,
        url: SITE.url,
        author: { "@type": "Person", name: SITE.name, url: SITE.url },
      };
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- No favicon. The empty data URL stops the browser asking for /favicon.ico. -->
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title={SITE.domain} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#252525" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.domain} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={SITE.twitter} />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />

    <script is:inline>
      (function () {
        // The visitor's pick wins; without one the site follows the system theme.
        // Exposed so the toggle and palette share it.
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        const THEME_COLORS = { dark: "#252525", light: "#ffffff" };
        // Kept in memory too, so the pick still applies where storage is blocked.
        let picked;
        const storedTheme = function () {
          try {
            return localStorage.getItem("theme");
          } catch {
            return null;
          }
        };
        window.setTheme = function (theme) {
          picked = theme;
          try {
            localStorage.setItem("theme", theme);
          } catch {
            // Storage blocked or full: the pick lasts until the page reloads.
          }
          window.applySavedTheme();
        };
        // A light-switch click, made with Web Audio so there's no file to load:
        // two short filtered noise bursts, the press and the snap back.
        let audio;
        const click = function (at, frequency, volume) {
          const length = Math.floor(audio.sampleRate * 0.025);
          const buffer = audio.createBuffer(1, length, audio.sampleRate);
          const samples = buffer.getChannelData(0);
          for (let i = 0; i < length; i += 1) {
            samples[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 6);
          }
          const source = audio.createBufferSource();
          source.buffer = buffer;
          const filter = audio.createBiquadFilter();
          filter.type = "bandpass";
          filter.frequency.value = frequency;
          filter.Q.value = 2;
          const gain = audio.createGain();
          gain.gain.value = volume;
          source.connect(filter).connect(gain).connect(audio.destination);
          source.start(at);
        };
        const playSwitch = function () {
          try {
            audio = audio || new AudioContext();
            if (audio.state === "suspended") {
              audio.resume();
            }
            click(audio.currentTime, 2600, 0.9);
            click(audio.currentTime + 0.04, 1500, 0.5);
          } catch {
            // No audio (old browser or blocked): the theme still switches.
          }
        };
        window.toggleTheme = function () {
          const isDark = document.documentElement.classList.contains("dark");
          window.setTheme(isDark ? "light" : "dark");
          playSwitch();
        };
        window.applySavedTheme = function () {
          const saved = picked || storedTheme();
          const system = systemDark.matches ? "dark" : "light";
          const theme = saved === "dark" || saved === "light" ? saved : system;
          document.documentElement.classList.toggle("dark", theme === "dark");
          document.documentElement.style.colorScheme = theme;
          // The browser chrome follows the theme on screen, not the system one.
          for (const meta of document.querySelectorAll('meta[name="theme-color"]')) {
            meta.content = THEME_COLORS[theme];
          }
        };

        window.applySavedTheme();

        if (!window.hasThemeRouterSync) {
          document.addEventListener("astro:after-swap", window.applySavedTheme);
          systemDark.addEventListener("change", window.applySavedTheme);
          window.hasThemeRouterSync = true;
        }
      })();
    </script>
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="50047cd7-0f24-4458-900a-a1c99a60782e"
      data-domains="shivam.ing,www.shivam.ing"></script>
    <ClientRouter fallback="swap" />
    <script>
      import "@/lib/instant-nav";
    </script>
  </head>

  <body class="bg-background text-foreground/75 min-h-dvh w-full antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:bg-background focus:px-2 focus:py-1"
    >
      skip to content
    </a>
    <main
      id="main"
      class="mx-auto w-full max-w-2xl px-3 pb-24 pt-6 sm:px-4 md:px-6 md:pt-[14vh]"
    >
      <slot />
    </main>
    <CommandPalette client:idle transition:persist="command-palette" items={urls} />
  </body>
</html>
