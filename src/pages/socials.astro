---
import PageHeader from "@/components/PageHeader.astro";
import { socials } from "@/data";
import Layout from "@/layouts/layout.astro";
import { SITE } from "@/site";

const links = [
  ...socials.map((social) => ({ title: social.title, href: social.link, external: true })),
  { title: "email", href: `mailto:${SITE.email}`, external: false },
  { title: "rss", href: "/rss.xml", external: false },
];
---

<Layout title="socials" description="where to find me.">
  <PageHeader title="socials" />
  <ul class="space-y-2">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="text-muted-foreground transition-colors hover:text-foreground"
          >
            {link.title}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
