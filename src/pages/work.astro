---
import PageHeader from "@/components/PageHeader.astro";
import Layout from "@/layouts/layout.astro";
import { SITE } from "@/site";
---

<Layout title="work" description="want to work together? i do content and eng.">
  <PageHeader title="want to work?" />
  <div class="space-y-3">
    <p class="text-foreground/50">i do.</p>
    <ul class="list-disc space-y-1 pl-5 text-foreground/50">
      <li>content.</li>
      <li>eng.</li>
    </ul>
    <p>
      email{" "}
      <a
        href={`mailto:${SITE.email}`}
        class="text-primary underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground"
      >
        {SITE.email}
      </a>
    </p>
  </div>
</Layout>
