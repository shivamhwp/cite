---
import PageHeader from "@/components/PageHeader.astro";
import { made_projects, socials } from "@/data";
import Layout from "@/layouts/layout.astro";
import { SITE } from "@/site";

const CONTENT_CHANNELS: Record<string, string> = { yt: "youtube", x: "x" };
const LEADING_WWW = /^www\./;

const channels = socials.flatMap((social) => {
  const label = CONTENT_CHANNELS[social.title];
  if (!label) {
    return [];
  }
  const url = new URL(social.link);
  return [{ label, href: social.link, display: `${url.host.replace(LEADING_WWW, "")}${url.pathname}` }];
});

const rowLink = "text-foreground/70 hover:text-foreground";
const inlineLink =
  "text-foreground/70 underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground";
---

<Layout title="work" description="i do content and eng. here's what i've built and where to reach me.">
  <PageHeader title="want to work?" />
  <p class="mb-10 text-foreground/50">i do content and eng.</p>

  <div class="flex flex-col gap-10">
    <section aria-labelledby="work-eng">
      <div class="mb-3 flex items-center gap-3">
        <h2 id="work-eng" class="shrink-0 font-normal text-foreground/70">eng</h2>
        <hr class="flex-1 border-muted-foreground/20" />
      </div>
      <ul class="flex flex-col gap-2">
        {
          made_projects.map((project) => (
            <li class="flex flex-col gap-x-6 sm:flex-row sm:items-baseline">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[rowLink, "shrink-0 sm:w-28"]}
              >
                {project.name}
              </a>
              <span class="inline-flex flex-wrap items-baseline gap-x-1 text-foreground/40">
                {project.description.map((part) =>
                  typeof part === "string" ? (
                    <span>{part.trim()}</span>
                  ) : (
                    <a href={part.link} target="_blank" rel="noopener noreferrer" class={inlineLink}>
                      {part.text}
                    </a>
                  ),
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="work-content">
      <div class="mb-3 flex items-center gap-3">
        <h2 id="work-content" class="shrink-0 font-normal text-foreground/70">content</h2>
        <hr class="flex-1 border-muted-foreground/20" />
      </div>
      <ul class="flex flex-col gap-2">
        {
          channels.map((channel) => (
            <li class="flex flex-col gap-x-6 sm:flex-row sm:items-baseline">
              <a
                href={channel.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[rowLink, "shrink-0 sm:w-28"]}
              >
                {channel.label}
              </a>
              <span class="text-foreground/40">{channel.display}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="work-contact" class="flex flex-wrap items-center gap-x-3 gap-y-1">
      <h2 id="work-contact" class="shrink-0 font-normal text-foreground/70">reach out</h2>
      <hr class="min-w-8 flex-1 border-muted-foreground/20" />
      <a href={`mailto:${SITE.email}`} class={inlineLink}>{SITE.email}</a>
    </section>
  </div>
</Layout>
