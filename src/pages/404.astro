---
import { not_found_images } from "@/data";
import Layout from "@/layouts/layout.astro";

const imageUrls = not_found_images.map((image) => image.url);
---

<Layout title="404" description="i think the url is wrong, btw hi." noindex>
  <div class="flex flex-col items-center py-12 text-center">
    <h1 class="mb-6 text-foreground">404</h1>
    <img
      id="not-found-image"
      src={imageUrls[0]}
      alt=""
      class="mb-8 h-auto w-full max-w-xs opacity-80"
      data-images={JSON.stringify(imageUrls)}
    />
    <p class="mb-10 text-muted-foreground">i think the url is wrong, btw hi.</p>
    <a href="/" class="text-muted-foreground transition-colors hover:text-foreground">
      go back to shiganshina
    </a>
  </div>
</Layout>

<script>
  const pickImage = () => {
    const image = document.getElementById("not-found-image");
    if (!(image instanceof HTMLImageElement)) {
      return;
    }
    const urls: unknown = JSON.parse(image.dataset.images ?? "[]");
    if (Array.isArray(urls) && urls.length > 0) {
      image.src = String(urls[Math.floor(Math.random() * urls.length)]);
    }
  };
  document.addEventListener("astro:page-load", pickImage);
</script>
