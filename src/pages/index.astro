---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { socials, work } from "@/data";
import Layout from "@/layouts/layout.astro";
import { ROUTES, SITE } from "@/site";

const muted = "text-foreground/40 hover:text-foreground/85";
// Label on the left, links straight after it.
const row = "flex flex-wrap items-baseline gap-x-2";
const label = "shrink-0 font-normal";
const links = "flex flex-wrap items-baseline gap-x-2";
---

<Layout>
  <div class="flex flex-col gap-1">
    <header class={row}>
      <h1 class:list={[label, "text-foreground"]}>shivam.</h1>
      <div class={links}>
        <nav aria-label="primary" class="contents">
          {
            ROUTES.map((route) => (
              <a href={route.href} aria-keyshortcuts={route.shortcut} class={muted}>
                {route.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <section id="work" aria-labelledby="work-title" class:list={[row, "scroll-mt-8"]}>
      <h2 id="work-title" class:list={[label, "text-foreground/70"]}>worked with</h2>
      <ul class={links}>
        {
          work.map((place) => (
            <li>
              <a href={place.link} target="_blank" rel="noopener noreferrer" class={muted}>
                {place.name}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class={row}>
      <a href={`mailto:${SITE.email}`} class:list={[label, muted]}>{SITE.email}</a>
      <div class={links}>
        {
          socials.map((social) => (
            <a href={social.link} target="_blank" rel="noopener noreferrer" class={muted}>
              {social.title}
            </a>
          ))
        }
      </div>
    </footer>
  </div>
</Layout>
