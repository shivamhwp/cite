---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { apps, socials, worked_with, working_with } from "@/data";
import Layout from "@/layouts/layout.astro";
import { ROUTES, SITE } from "@/site";

const muted = "text-foreground/40 hover:text-foreground/85";
// One gap between every item, labels and links alike.
const row = "flex flex-wrap items-baseline gap-x-2 gap-y-1";
const label = "shrink-0 font-normal";
const links = "flex flex-wrap items-baseline gap-x-2 gap-y-1";

const workRows = [
  { title: "working with", places: working_with },
  { title: "worked with", places: worked_with },
];
---

<Layout>
  <div class="flex flex-col gap-1">
    <header class={row}>
      <h1 class:list={[label, "text-foreground"]}>shivam.</h1>
      <div class={links}>
        <nav aria-label="primary" class="contents">
          {
            ROUTES.map((route) => (
              <a href={route.href} aria-keyshortcuts={route.shortcut} class={muted}>
                {route.label}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </header>

    <section id="work" aria-labelledby="work-title" class="flex scroll-mt-8 flex-col gap-1">
      <h2 id="work-title" class="sr-only">work</h2>
      <p class={row}>
        {
          workRows.map((workRow) => (
            <>
              <span class:list={[label, "text-foreground/70"]}>{workRow.title}</span>{" "}
              {workRow.places.map((place) => (
                <>
                  <a href={place.link} target="_blank" rel="noopener noreferrer" class={muted}>
                    {place.name}
                  </a>{" "}
                </>
              ))}
            </>
          ))
        }
      </p>
      <p class={row}>
        {
          apps.map((app) => (
            <>
              <a href={app.link} target="_blank" rel="noopener noreferrer" class={muted}>
                {app.name}
              </a>{" "}
            </>
          ))
        }
      </p>
    </section>

    <footer class={row}>
      <a href={`mailto:${SITE.email}`} class:list={[label, muted]}>{SITE.email}</a>
      <div class={links}>
        {
          socials.map((social) => (
            <a href={social.link} target="_blank" rel="noopener noreferrer" class={muted}>
              {social.title}
            </a>
          ))
        }
      </div>
    </footer>
  </div>
</Layout>
