---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BackLink from "@/components/BackLink.astro";
import Layout from "@/layouts/layout.astro";
import {
  excerpt,
  formatDate,
  getPosts,
  type Post,
  postHref,
  postTags,
  readingMinutes,
  tagHref,
} from "@/lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, published, updated, director, imageUrl } = post.data;
const tags = postTags(post);
const wasUpdated = updated && updated.getTime() !== published.getTime();
---

<Layout
  title={title}
  description={excerpt(post)}
  image={imageUrl}
  type="article"
  published={published}
  updated={updated}
>
  <article>
    <header class="mb-8 border-b border-muted-foreground/10 pb-5">
      <div class="mb-3 flex items-start justify-between gap-4">
        <h1 class="font-normal leading-snug text-foreground">{title}</h1>
        <div class="mt-1 shrink-0">
          <BackLink href="/writings" label="writing" />
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-muted-foreground">
        <time datetime={published.toISOString()}>{formatDate(published)}</time>
        {
          wasUpdated && (
            <>
              <span class="opacity-30">·</span>
              <span>
                updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
        {
          director && (
            <>
              <span class="opacity-30">·</span>
              <span>{director}</span>
            </>
          )
        }
        <span class="opacity-30">·</span>
        <span>{readingMinutes(post)} min</span>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-x-3 gap-y-1 text-foreground/35">
          {tags.map((tag) => (
            <li>
              <a href={tagHref(tag)} class="hover:text-foreground/85">
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </article>

  <nav
    aria-label="more writing"
    class="mt-10 flex justify-between gap-6 border-t border-muted-foreground/10 pt-5"
  >
    {
      older ? (
        <a href={postHref(older)} class="min-w-0 text-muted-foreground hover:text-foreground">
          <span class="block text-foreground/30">older</span>
          <span class="block truncate">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a
          href={postHref(newer)}
          class="min-w-0 text-right text-muted-foreground hover:text-foreground"
        >
          <span class="block text-foreground/30">newer</span>
          <span class="block truncate">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Layout>
